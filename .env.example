# App settings
APP_NAME="Company Chatbot Backend"
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-insecure-secret-key-32-chars-minimum-ok
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# MongoDB (Two Databases, Three Credentials)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=app_data
MONGODB_BUSINESS_DB=business_data
MONGODB_BUSINESS_URL_READER=mongodb://localhost:27017
MONGODB_BUSINESS_URL_WRITER=mongodb://localhost:27017

# Redis (Cache & Rate limits; blank uses in-memory)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Options: "gemini" | "openai_compat" | "azure" | "fake")
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_CONCURRENCY=3

# Gemini Free Tier Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=2

# OpenAI-Compatible Configuration (Groq, OpenRouter, Mistral, Together, Ollama)
# Groq: https://api.groq.com/openai/v1 (e.g. llama-3.3-70b-versatile)
# OpenRouter: https://openrouter.ai/api/v1 (e.g. meta-llama/llama-3.3-70b-instruct:free)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=your_openai_compat_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.0

# Azure OpenAI Configuration (Legacy/Enterprise)
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=

# Email Backend
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME="Company Auth"
SMTP_TLS=true
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Internal Service Tokens
SERVICE_TOKEN=internal-service-secret-token

# Rate Limits and Budgets
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_TENANT_PER_MINUTE=300
MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=5
HISTORY_TURNS=6
